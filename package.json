{
  "name": "game2d-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "game2D Multi-Game Arcade Monorepo",
  "type": "module",
  "workspaces": [
    "games/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:rillkeepers": "npm --prefix games/rillkeepers run dev",
    "build:rillkeepers": "npm --prefix games/rillkeepers run build",
    "test:rillkeepers": "npm --prefix games/rillkeepers run test",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
